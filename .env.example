# 管理后台（生产环境请放到受限权限的 EnvironmentFile）
ADMIN_PORT=3000
ADMIN_HOST=127.0.0.1
ADMIN_PASSWORD_HASH=scrypt$...
# 可选：开启动态验证码
# ADMIN_TOTP_SECRET=...

# 数据与密钥保管库
DATABASE_PATH=./data/brief.db
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret
SECRETS_PATH=./data/secrets.enc

# Telegram 独立数据库与本机登录 Socket；API ID/Hash/手机号通过后台写入加密保管库。
TELEGRAM_DATABASE_PATH=./data/telegram.sqlite3
TELEGRAM_SESSION_PATH=./data/telegram
TELEGRAM_LOGIN_SOCKET=./data/telegram-login.sock
TELEGRAM_PYTHON=./telegram-worker/.venv/bin/python
TELEGRAM_MEDIA_DIR=./data/telegram-media

# AI 默认使用本地 mock，实际运行可在后台“设置”页覆盖。
AI_PROVIDER=mock
AI_L1_MODEL=mock-model
# 每层都可单独指定供应商、模型和 OpenAI 兼容端点：
# AI_L1_PROVIDER=openai
# AI_L1_MODEL=gpt-5.6-luna
# AI_L1_BASE_URL=https://api.openai.com/v1
# AI_L2_PROVIDER=deepseek
# AI_L2_MODEL=deepseek-chat
# AI_L2_BASE_URL=https://api.deepseek.com/v1
# AI_L3_PROVIDER=anthropic
# AI_L3_MODEL=claude-sonnet-4-20250514
