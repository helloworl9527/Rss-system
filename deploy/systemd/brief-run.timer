[Unit]
Description=三个固定窗口触发完整简报运行（早报/午报/晚报）

[Timer]
# PRD 5.1 的三个固定窗口时刻，内联台北时区。
OnCalendar=*-*-* 08:00:00 Asia/Taipei
OnCalendar=*-*-* 12:00:00 Asia/Taipei
OnCalendar=*-*-* 22:00:00 Asia/Taipei
# PRD 5.3：计划时间后 0–10 分钟触发仍属正常
RandomizedDelaySec=120
# 服务器离线恢复后补跑，但 brief.ts 默认不重复投递（deliveries 唯一键）
Persistent=true
AccuracySec=30s
Unit=brief-run.service

[Install]
WantedBy=timers.target
